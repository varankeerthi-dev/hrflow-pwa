rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Membership is stored either in the legacy `orgId` field or in the
    // `memberships` array. The client always keeps `orgId`/`currentOrgId`
    // pointing at the currently-active org, so checking both is sufficient.
    function isOrgMember(orgId) {
      let ud = userData();
      return ud != null && (ud.orgId == orgId || ud.currentOrgId == orgId);
    }

    // Org admins are whoever appears in the organisation doc's `adminUids` list.
    function isOrgAdmin(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/organisations/$(orgId))
        && get(/databases/$(database)/documents/organisations/$(orgId)).data.adminUids.hasAny([request.auth.uid]);
    }

    // Reads stay open to any signed-in user so the invitation self-registration
    // (collectionGroup email lookup) and join-by-code flows keep working.
    function canReadOrg() {
      return isSignedIn();
    }

    // Writes require actual membership in that organisation.
    function canWriteOrg(orgId) {
      return isOrgMember(orgId) || isOrgAdmin(orgId);
    }

    function isHROrAdmin(orgId) {
      let role = isSignedIn() && userData() != null ? userData().role : '';
      return isOrgAdmin(orgId)
        || (isOrgMember(orgId) && role in ['admin', 'Admin', 'hr', 'HR']);
    }

    function isOwnCommunicationDelivery() {
      let ud = userData();
      return isSignedIn() && ud != null
        && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == ud.employeeId);
    }

    // A user may edit their own profile, but never promote themselves:
    // `role` / `permissions` are only ever changed by org admins.
    function isSelfWriteAllowed() {
      return resource == null
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']);
    }

    // Cross-user user-doc writes are only allowed for admins of an org the
    // target user currently belongs to (via the `orgId` field).
    function isAdminOfExistingUser() {
      let ud = resource.data;
      return resource != null && ud.orgId != null && isOrgAdmin(ud.orgId);
    }

    // ── Users (top level) ────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        (request.auth.uid == userId && isSelfWriteAllowed())
        || isAdminOfExistingUser()
        || (resource == null && request.resource.data.orgId != null && isOrgAdmin(request.resource.data.orgId))
      );
    }

    // ── Reminders (top level) ────────────────────────────────────────────────

    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── Personal checklists (top level, owner-scoped) ────────────────────────

    function isOwnChecklistDoc() {
      return resource == null
        ? request.resource.data.userId == request.auth.uid
        : (resource.data.userId == request.auth.uid
           && (request.resource == null || request.resource.data.userId == request.auth.uid));
    }

    match /checklist_templates/{templateId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && isOwnChecklistDoc();
    }

    match /checklist_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && isOwnChecklistDoc();
    }

    // ── Organisations ────────────────────────────────────────────────────────

    match /organisations/{orgId} {
      allow read: if canReadOrg();
      allow write: if isSignedIn() && (
        // Org creation: the creator declares themselves in `adminUids`.
        (resource == null && request.resource.data.adminUids.hasAny([request.auth.uid]))
        || isOrgAdmin(orgId)
        // Members may update settings but never the admin list or the join code.
        || (resource != null && canWriteOrg(orgId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminUids', 'code']))
      );

      match /leave_attendance_coverage/{coverageId} {
        allow read: if isOrgMember(orgId) || isOrgAdmin(orgId);
        allow write: if isHROrAdmin(orgId);
      }

      match /leave_lifecycle_events/{eventId} {
        allow read: if isOrgMember(orgId) || isOrgAdmin(orgId);
        allow write: if isHROrAdmin(orgId);
      }

      match /employees/{empId}/leave_ledger/{entryId} {
        allow read: if isOrgMember(orgId) || isOrgAdmin(orgId);
        allow write: if isHROrAdmin(orgId);
      }

      match /communication_templates/{templateId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /letters/{letterId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /announcements/{announcementId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /policy_documents/{policyId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /training_programmes/{programmeId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /communication_audit/{auditId} {
        allow read, write: if isHROrAdmin(orgId);
      }

      match /communication_deliveries/{deliveryId} {
        allow read: if isHROrAdmin(orgId) || isOwnCommunicationDelivery();
        allow create, delete: if isHROrAdmin(orgId);
        allow update: if isHROrAdmin(orgId) || (isOwnCommunicationDelivery()
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.sourceId == resource.data.sourceId
          && request.resource.data.sourceType == resource.data.sourceType
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seenAt', 'acknowledgedAt', 'updatedAt']));
      }

      // All organisation sub-collections (attendance, employees, payroll, chats,
      // nested logs, etc.): readable by any signed-in user, writable by members/admins.
      match /{c1}/{d1} {
        allow read: if canReadOrg();
        allow write: if canWriteOrg(orgId)
          && !(c1 in ['leave_attendance_coverage', 'leave_lifecycle_events', 'communication_templates', 'letters', 'announcements', 'policy_documents', 'training_programmes', 'communication_deliveries', 'communication_audit']);
      }

      // Nested sub-collections: employee_portal/.../attendance_logs,
      // chats/.../messages, vehicles/.../history, payroll_runs/.../slips.
      match /{c1}/{d1}/{c2}/{d2} {
        allow read: if canReadOrg();
        allow write: if canWriteOrg(orgId) && !(c1 == 'employees' && c2 == 'leave_ledger');
      }
    }

    // Everything else is denied by default (no catch-all).
  }
}
